{
  "manifest_version": 3,
  "name": "Privacy Browser Agent",
  "version": "1.0.0",
  "description": "Privacy-preserving browser agent for on-device visual perception with local vision processing.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Privacy Browser Agent"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils.js",
        "privacy-filter.js",
        "vision-processor.js",
        "onnx-vision-model.js",
        "command-executor.js",
        "session-manager.js",
        "agent-loop.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "node_modules/onnxruntime-web/dist/*.js",
        "node_modules/onnxruntime-web/dist/*.mjs",
        "node_modules/onnxruntime-web/dist/*.wasm",
        "models/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
